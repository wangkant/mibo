; Simplified Chinese for Mibo's setup, read over compiler:Default.isl:
; the pages, buttons and messages this setup and its uninstaller show.
; Anything not here stays English.

[LangOptions]
LanguageName=简体中文
LanguageID=$0804
LanguageCodePage=936

